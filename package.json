{
  "name": "cubby-slicer",
  "version": "0.1.0",
  "description": "Standalone browser slicer for CubbyCAD — upload an STL, pick a profile, slice to G-code. Bundles CuraEngine / OrcaSlicer / PrusaSlicer WASM (AGPL-3.0).",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://cubbycad.com/slicer",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/JoshTheDerf/cubbyslicer.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@cubby/shared": "github:JoshTheDerf/cubby-shared",
    "@nuxt/ui": "^4.11.2",
    "manifold-3d": "^3.5.4",
    "meshoptimizer": "^1.3.0",
    "occt-import-js": "^0.0.23",
    "opentype.js": "^2.0.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.182.0",
    "three-viewport-gizmo": "^2.2.0",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.136",
    "@types/node": "^24.10.1",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "fflate": "^0.8.3",
    "playwright": "^1.59.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.5",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.1.4"
  }
}
